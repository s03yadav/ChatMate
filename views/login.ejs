<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('partials/header') %>
        <title>Team Chat - Workspace Sign In</title>
        <!-- Apple System Fonts Fallback / Inter -->
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        
        <style>
            :root {
                /* iOS Dark Theme Color Palette */
                --apple-blue: #007aff;
                --apple-blue-hover: #0062cc;
                --bg-canvas: #000000;
                --card-bg: rgba(28, 28, 30, 0.75);
                --input-bg: rgba(44, 44, 46, 0.8);
                --input-border: rgba(255, 255, 255, 0.1);
                --input-focus-border: #007aff;
                --text-main: #f5f5f7;
                --text-muted: #8e8e93;
                --text-label: #ebebf5;
            }

            body {
                background-color: var(--bg-canvas);
                /* Radial background glow reminiscent of modern macOS/iOS overlays */
                background-image: 
                    radial-gradient(circle at 50% 0%, rgba(0, 122, 255, 0.15) 0%, transparent 50%),
                    radial-gradient(circle at 80% 100%, rgba(0, 122, 255, 0.08) 0%, transparent 40%);
                background-attachment: fixed;
                font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", 'Inter', system-ui, sans-serif;
                color: var(--text-main);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
                padding: 2rem 1rem;
                -webkit-font-smoothing: antialiased;
            }

            /* Glassmorphic iMessage Container */
            .container-md {
                width: 100%;
                max-width: 440px !important;
                background: var(--card-bg);
                backdrop-filter: blur(30px);
                -webkit-backdrop-filter: blur(30px);
                padding: 2.75rem 2.5rem;
                border-radius: 24px;
                border: 1px solid rgba(255, 255, 255, 0.12);
                box-shadow: 
                    0 20px 40px rgba(0, 0, 0, 0.6),
                    inset 0 1px 0 rgba(255, 255, 255, 0.1);
            }

            /* iMessage Header Icon & Legend Styling */
            .app-header {
                text-align: center;
                margin-bottom: 2rem;
            }

            .app-icon {
                width: 60px;
                height: 60px;
                background: linear-gradient(135deg, #007aff 0%, #0051a8 100%);
                border-radius: 14px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 1rem;
                box-shadow: 0 8px 16px rgba(0, 122, 255, 0.3);
            }

            .app-icon svg {
                width: 32px;
                height: 32px;
                fill: #ffffff;
            }

            legend {
                font-size: 1.65rem;
                font-weight: 700;
                color: var(--text-main);
                letter-spacing: -0.015em;
                border-bottom: none;
                padding-bottom: 0;
                margin-bottom: 0.25rem;
                text-align: center;
            }

            .subtitle {
                font-size: 0.875rem;
                color: var(--text-muted);
                text-align: center;
                margin-bottom: 1.75rem;
                font-weight: 400;
            }

            /* Labels */
            .form-label {
                font-size: 0.825rem;
                font-weight: 500;
                color: var(--text-label);
                margin-bottom: 0.4rem;
                letter-spacing: -0.01em;
                display: block;
            }

            .label-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            /* Form Inputs - Sleek iOS Style */
            .form-control {
                padding: 0.8rem 1rem;
                font-size: 0.95rem;
                border-radius: 12px;
                border: 1px solid var(--input-border);
                background-color: var(--input-bg);
                color: var(--text-main);
                transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                width: 100%;
                box-sizing: border-box;
            }

            .form-control:focus {
                background-color: rgba(58, 58, 60, 0.9);
                border-color: var(--apple-blue);
                box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.25);
                color: #ffffff;
                outline: none;
            }

            .form-control::placeholder {
                color: rgba(235, 235, 245, 0.35);
                font-size: 0.9rem;
            }

            /* Action Button - Signature iOS Blue Pill Button */
            .btn-primary {
                background: linear-gradient(180deg, #007aff 0%, #0062cc 100%);
                border: none;
                font-weight: 600;
                padding: 0.85rem 1.25rem;
                border-radius: 14px;
                width: 100%;
                font-size: 1rem;
                letter-spacing: -0.01em;
                color: #ffffff;
                box-shadow: 0 4px 14px rgba(0, 122, 255, 0.35);
                transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                cursor: pointer;
            }

            .btn-primary:hover {
                background: linear-gradient(180deg, #1a87ff 0%, #0069d9 100%);
                transform: scale(1.01);
                box-shadow: 0 6px 20px rgba(0, 122, 255, 0.45);
            }

            .btn-primary:active {
                transform: scale(0.98);
                opacity: 0.9;
            }

            /* Helper Links */
            .auth-link {
                color: var(--apple-blue);
                font-size: 0.825rem;
                text-decoration: none;
                transition: color 0.2s ease;
            }

            .auth-link:hover {
                color: #3395ff;
                text-decoration: underline;
            }

            .footer-text {
                text-align: center;
                margin-top: 1.75rem;
                font-size: 0.875rem;
                color: var(--text-muted);
            }
        </style>
</head>

<body>
    <div class="container-md">
        <div class="app-header">
            <div class="app-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/>
                </svg>
            </div>
            <legend>Welcome Back</legend>
            <div class="subtitle">Sign in to continue to your workspace</div>
        </div>

        <form method="POST" action="/login">
            <div class="mb-3">
                <label class="form-label">Email </label>
                <input type="text" name="email" class="form-control" placeholder="Enter your email or username" required>
            </div>
            <div class="mb-3">
                <div class="label-row">
                    <label class="form-label">Password</label>
                    <a href="/forgot-password" class="auth-link" style="margin-bottom: 0.4rem;">Forgot?</a>
                </div>
                <input type="password" name="password" class="form-control" placeholder="Enter your password" required>
            </div>
            <button type="submit" class="btn btn-primary mt-4">Sign In</button>
        </form>

        <div class="footer-text">
            Don't have a workspace? <a href="/signup" class="auth-link">Create one</a>
        </div>
    </div>
</body>

</html>