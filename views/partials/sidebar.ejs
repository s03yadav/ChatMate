<!-- LEFT SIDEBAR -->
<div class="col-4 col-md-3 sidebar">

  <!-- Header & Logo -->
  <div class="sidebar-header">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-chat-fill text-primary fs-4"></i>
        <h5 class="fw-bold mb-0">Messages</h5>
      </div>
      <!-- CREATE GROUP BUTTON (Triggers Modal) -->
      <button class="btn btn-primary btn-sm rounded-pill d-flex align-items-center gap-1" id="createGroupBtn"
        type="button" data-bs-toggle="modal" data-bs-target="#createGroupModal">
        <i class="bi bi-people-fill"></i>
        <span class="d-none d-lg-inline">New Team</span>
      </button>
    </div>
    <div class="position-relative">
      <i class="bi bi-search position-absolute search-icon"></i>
      <input type="text" class="form-control search-box" placeholder="Search chats..." readonly>
    </div>
  </div>

  <!-- Scrollable Chat & Team List -->
  <div class="chat-list">

    <!-- SECTION 1: TEAMS -->
    <div class="sidebar-section mb-2">
      <div
        class="px-3 py-2 text-uppercase text-muted fw-bold extra-small tracking-wider d-flex align-items-center justify-content-between">
        <span>Teams</span>
        <span class="badge bg-light text-secondary rounded-pill">
          <%= teams ? teams.length : 0 %>
        </span>
      </div>

      <% if (typeof teams !=='undefined' && teams.length> 0) { %>
        <% teams.forEach(team=> { %>
          <div class="chat-item team-item" data-id="<%= team._id %>" data-type="team">
            <img src="<%= team.image || team.groupPicture || '/user/default.jpg' %>" alt="Team Avatar"
              class="chat-avatar me-3">
            <div class="flex-grow-1 overflow-hidden me-2">
              <div class="d-flex justify-content-between align-items-baseline">
                <h6 class="mb-0 text-truncate fw-semibold">
                  <%= team.name || team.groupName %>
                </h6>
                <span class="chat-time">
                  <%= team?.lastMessagedAt ? new Date(team.lastMessagedAt).toLocaleTimeString("default", {
                    hour: "2-digit" , minute: "2-digit" }) : "" %>
                </span>
              </div>
              <p class="chat-preview mb-0 text-truncate">
                <%= team?.lastMessage ? team.lastMessage.slice(0, 15) : (team.description || "Team workspace" ) %>
              </p>
            </div>
          </div>
          <% }) %>
            <% } else { %>
              <div class="px-3 py-2 text-muted small fst-italic">No teams yet</div>
              <% } %>
    </div>

    <!-- DIVIDER -->
    <hr class="my-2 opacity-10 mx-3">

    <!-- SECTION 2: DIRECT MESSAGES -->
    <div class="sidebar-section">
      <div
        class="px-3 py-2 text-uppercase text-muted fw-bold extra-small tracking-wider d-flex align-items-center justify-content-between">
        <span>Direct Messages</span>
        <span class="badge bg-light text-secondary rounded-pill">
          <%= users ? users.length : 0 %>
        </span>
      </div>

      <% if (typeof users !=='undefined' && users.length> 0) { %>
        <% users.forEach(item=> { %>
          <div class="chat-item user" data-id="<%= item.user._id %>" data-type="direct">
            <img src="<%= item.user.profilePicture %>" alt="User Profile" class="chat-avatar me-3">
            <div class="flex-grow-1 overflow-hidden me-2">
              <div class="d-flex justify-content-between align-items-baseline">
                <h6 class="mb-0 text-truncate fw-semibold">
                  <%= item.user.fullName %>
                </h6>
                <span class="chat-time">
                  <%= item?.chat?.lastMessagedAt ? new Date(item.chat.lastMessagedAt).toLocaleTimeString("default", {
                    hour: "2-digit" , minute: "2-digit" }) : "" %>
                </span>
              </div>
              <p class="chat-preview mb-0 text-truncate">
                <%= item?.chat?.lastMessage ? item.chat.lastMessage.slice(0, 15) : "" %>
              </p>
            </div>
          </div>
          <% }) %>
            <% } else { %>
              <div class="px-3 py-2 text-muted small fst-italic">No direct messages</div>
              <% } %>
    </div>

  </div>

  <!-- Fixed Bottom Profile (Clickable Trigger) -->
  <% if (loggedUser) { %>
    <div class="sidebar-profile d-flex align-items-center cursor-pointer hover-bg transition-all" role="button"
      data-bs-toggle="modal" data-bs-target="#currentUserProfileModal">
      <div class="position-relative me-3">
        <img src="<%= loggedUser.profilePicture %>" alt="Current User" class="chat-avatar">
        <span class="status-indicator"></span>
      </div>
      <div class="overflow-hidden flex-grow-1">
        <h6 class="mb-0 text-truncate fw-semibold" style="font-size: 0.9rem;">
          <%= loggedUser.fullName || loggedUser.userName %>
        </h6>
        <span class="text-muted small">@<%= loggedUser.userName %></span>
      </div>
      <i class="bi bi-chevron-right text-muted small me-1"></i>
    </div>
    <% } %>

</div>

<!-- APPLE-STYLE LOGGED USER PROFILE MODAL -->
<% if (loggedUser) { %>
  <div class="modal fade" id="currentUserProfileModal" tabindex="-1" aria-labelledby="currentUserProfileModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden"
        style="background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);">

        <!-- Apple macOS Header Bar -->
        <div
          class="modal-header border-0 pb-0 pt-3 px-3 position-relative d-flex justify-content-between align-items-center">
          <span class="extra-small text-uppercase fw-bold text-muted tracking-wider ms-1">User Account</span>
          <button type="button" class="btn-close rounded-circle bg-light p-2 shadow-none border-0"
            data-bs-dismiss="modal" aria-label="Close" style="font-size: 0.7rem;"></button>
        </div>

        <div class="modal-body p-4 pt-2 text-center">

          <!-- Hero Avatar with Status Badge -->
          <div class="position-relative d-inline-block mb-3">
            <img src="<%= loggedUser.profilePicture %>" alt="<%= loggedUser.userName %>"
              class="rounded-circle shadow-sm border border-2 border-white object-fit-cover"
              style="width: 96px; height: 96px;">
            <span
              class="position-absolute bottom-0 end-0 bg-success border border-2 border-white rounded-circle p-2 me-1 mb-1"
              title="Active Now"></span>
          </div>

          <!-- Primary Name & Handle -->
          <h5 class="fw-bold text-dark mb-0 tracking-tight">
            <%= loggedUser.fullName || loggedUser.userName %>
          </h5>
          <p class="text-muted small mb-3">@<%= loggedUser.userName %>
          </p>

          <% if (loggedUser.status==="Online" ) { %>
            <div
              class="d-inline-flex align-items-center gap-2 bg-light px-3 py-1.5 rounded-pill mb-4 border border-1 border-black-10">
              <i class="bi bi-circle-fill text-success" style="font-size: 0.5rem;"></i>
              <span class="small fw-medium text-secondary">Available for messages</span>
            </div>
            <% } %>
              <!-- Quick Status Pill -->

              <!-- Grouped Apple Settings Card -->
              <div class="bg-white rounded-3 shadow-sm border border-1 text-start overflow-hidden mb-3">

                <!-- Email Row -->
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
                  <div class="d-flex align-items-center gap-3 overflow-hidden me-2">
                    <div
                      class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                      style="width: 32px; height: 32px; flex-shrink: 0;">
                      <i class="bi bi-envelope-fill small"></i>
                    </div>
                    <div class="overflow-hidden">
                      <div class="extra-small text-muted text-uppercase fw-bold">Email</div>
                      <div class="small fw-semibold text-dark text-truncate">
                        <%= loggedUser.email || "No email provided" %>
                      </div>
                    </div>
                  </div>
                  <i class="bi bi-shield-check text-success fs-5"></i>
                </div>

                <!-- Username Row -->
                <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
                  <div class="d-flex align-items-center gap-3 overflow-hidden me-2">
                    <div
                      class="bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center"
                      style="width: 32px; height: 32px; flex-shrink: 0;">
                      <i class="bi bi-at small"></i>
                    </div>
                    <div class="overflow-hidden">
                      <div class="extra-small text-muted text-uppercase fw-bold">Username</div>
                      <div class="small fw-semibold text-dark text-truncate">@<%= loggedUser.userName %>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Member Since / Info Row -->
                <div class="p-3 d-flex align-items-center justify-content-between">
                  <div class="d-flex align-items-center gap-3 overflow-hidden me-2">
                    <div
                      class="bg-secondary-subtle text-secondary rounded-circle d-flex align-items-center justify-content-center"
                      style="width: 32px; height: 32px; flex-shrink: 0;">
                      <i class="bi bi-clock-history small"></i>
                    </div>
                    <div class="overflow-hidden">
                      <div class="extra-small text-muted text-uppercase fw-bold">Member Since</div>
                      <div class="small fw-semibold text-dark text-truncate">
                        <%= loggedUser.createdAt ? new Date(loggedUser.createdAt).toLocaleDateString("en-US", {
                          month: "short" , year: "numeric" }) : "Active Member" %>
                      </div>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Security Footer Info -->
              <div class="d-flex align-items-center justify-content-center gap-1 text-muted extra-small mt-2">
                <i class="bi bi-lock-fill text-primary"></i>
                <span>End-to-End Encrypted iMessage Workspace</span>
              </div>

        </div>

      </div>
    </div>
  </div>
  <% } %>