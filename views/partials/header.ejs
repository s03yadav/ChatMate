<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Team Chat</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    /* System Font Stack & Reset */
    :root {
      --imessage-blue: #007aff;
      --imessage-gray: #e9e9eb;
      --sidebar-bg: #f5f5f7;
      --border-color: #e5e5ea;
      --text-muted: #8e8e93;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
      background-color: #f0f0f2;
      color: #1c1c1e;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Layout Containers */
    .app-container {
      height: 100vh;
      background-color: #ffffff;
      overflow: hidden;
    }

    /* Left Sidebar */
    .sidebar {
      background-color: var(--sidebar-bg);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      height: 100%;
      overflow: hidden;
    }

    .sidebar-header {
      padding: 16px 20px 12px;
      flex-shrink: 0;
    }

    .search-box {
      background-color: #e3e3e8;
      border: none;
      border-radius: 10px;
      padding: 6px 12px 6px 32px;
      font-size: 0.875rem;
    }

    .search-box:focus {
      background-color: #ffffff;
      box-shadow: 0 0 0 2px rgba(0, 122, 255, 0.3);
    }

    .search-icon {
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    .chat-list {
      flex: 1;
      overflow-y: auto;
      padding: 0 8px;
    }

    /* Chat Items */
    .chat-item {
      border: none;
      border-radius: 12px;
      padding: 10px 12px;
      margin-bottom: 2px;
      transition: background-color 0.15s ease;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
      display: flex;
      align-items: center;
    }

    .chat-item:hover {
      background-color: rgba(0, 0, 0, 0.04);
    }

    .chat-item.active {
      background-color: var(--imessage-blue);
      color: #ffffff;
    }

    .chat-item.active .text-muted,
    .chat-item.active .chat-time {
      color: rgba(255, 255, 255, 0.75) !important;
    }

    .chat-item.active .chat-preview {
      color: rgba(255, 255, 255, 0.9) !important;
    }

    .chat-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }

    /* Adjusted styles for chat preview and time */
    .chat-time {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 400;
      white-space: nowrap;
      margin-left: 6px;
    }

    .chat-preview {
      font-size: 0.8125rem;
      color: var(--text-muted);
      line-height: 1.25;
      margin-top: 2px;
    }

    .chat-item.unread {
      background-color: rgba(0, 122, 255, 0.08);
      box-shadow: inset 3px 0 0 #007aff;
    }

    /* Profile Footer */
    .sidebar-profile {
      height: 70px;
      border-top: 1px solid var(--border-color);
      background-color: rgba(245, 245, 247, 0.85);
      backdrop-filter: blur(10px);
      padding: 0 16px;
      flex-shrink: 0;
    }

    .status-indicator {
      width: 10px;
      height: 10px;
      background-color: #34c759;
      border: 2px solid var(--sidebar-bg);
      border-radius: 50%;
      position: absolute;
      bottom: 2px;
      right: 2px;
    }

    /* Chat Area */
    .chat-area {
      display: flex;
      flex-direction: column;
      height: 100%;
      background-color: #ffffff;
      position: relative;
      overflow: hidden;
    }

    .chat-header {
      height: 65px;
      border-bottom: 1px solid var(--border-color);
      padding: 0 24px;
      background-color: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(10px);
      flex-shrink: 0;
      cursor: pointer;
    }

    .messages-container {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    /* iMessage Bubble Styling */
    .message-row {
      display: flex;
      flex-direction: column;
      max-width: 65%;
    }

    .message-row.incoming {
      align-self: flex-start;
    }

    .message-row.outgoing {
      align-self: flex-end;
    }

    .message-bubble {
      padding: 10px 16px;
      font-size: 0.9375rem;
      line-height: 1.4;
      word-wrap: break-word;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }

    .incoming .message-bubble {
      background-color: var(--imessage-gray);
      color: #000000;
      border-radius: 18px 18px 18px 4px;
    }

    .outgoing .message-bubble {
      background-color: var(--imessage-blue);
      color: #ffffff;
      border-radius: 18px 18px 4px 18px;
    }

    .message-time {
      font-size: 0.7rem;
      color: var(--text-muted);
      margin-top: 4px;
      padding: 0 4px;
    }

    .outgoing .message-time {
      text-align: right;
    }

    .date-divider {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 500;
      text-align: center;
      margin: 12px 0;
    }

    /* Message Input Bar */
    .chat-input-area {
      padding: 16px 24px;
      border-top: 1px solid var(--border-color);
      background-color: #ffffff;
      flex-shrink: 0;
    }

    .chat-input {
      background-color: #f2f2f7;
      border: 1px solid transparent;
      border-radius: 20px;
      padding: 10px 16px;
      font-size: 0.9375rem;
    }

    .chat-input:focus {
      background-color: #ffffff;
      border-color: var(--imessage-blue);
      box-shadow: 0 0 0 3px rgba(0, 122, 255, 0.15);
    }

    .btn-send {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background-color: var(--imessage-blue);
      color: white;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.1s ease, opacity 0.15s ease;
      flex-shrink: 0;
    }

    .btn-send:hover {
      opacity: 0.9;
    }

    .btn-send:active {
      transform: scale(0.95);
    }

    /* Empty Chat State */
    .empty-chat-state {
      background-color: #fafafa;
      user-select: none;
    }

    .empty-state-icon-wrapper {
      width: 72px;
      height: 72px;
      background-color: rgba(0, 122, 255, 0.08);
      color: var(--imessage-blue);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      box-shadow: inset 0 0 0 1px rgba(0, 122, 255, 0.12);
    }

    .max-w-360 {
      max-width: 360px;
      line-height: 1.5;
    }

    .extra-small {
      font-size: 0.75rem;
    }

    /* Avatar inside message row */
    .message-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }

    /* Sender Name for Team Messages */
    .sender-name {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 2px;
      display: block;
      padding-left: 4px;
    }

    /* Ensure message wrapper handles horizontal alignment correctly with flexbox */
    .message-row .message-content {
      max-width: 100%;
      display: flex;
      flex-direction: column;
    }

    .message-row.outgoing .message-content {
      align-items: flex-end;
    }

    .message-row.incoming .message-content {
      align-items: flex-start;
    }
  </style>
</head>