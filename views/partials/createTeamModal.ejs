<!-- CREATE GROUP MODAL -->
    <div class="modal fade" id="createGroupModal" tabindex="-1" aria-labelledby="createGroupModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
          
          <div class="modal-header border-bottom-0 pb-0">
            <h5 class="modal-title fw-bold" id="createGroupModalLabel">
              <i class="bi bi-people-fill text-primary me-2"></i>Create New Team
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <form id="createGroupForm" action="/home" method="POST" enctype="multipart/form-data">
            <div class="modal-body py-3">
              <div class="row g-3">

                <!-- LEFT SIDE: GROUP INFORMATION -->
                <div class="col-12 col-md-6 border-end-md pe-md-3">
                  
                  <!-- Group Name -->
                  <div class="mb-3">
                    <label for="groupName" class="form-label small fw-semibold text-muted">Group Name</label>
                    <input type="text" class="form-control" id="groupName" name="groupName" placeholder="e.g. Design Team" required>
                  </div>

                  <!-- Group Image -->
                  <div class="mb-3">
                    <label for="groupImage" class="form-label small fw-semibold text-muted">Group Image</label>
                    <input type="file" class="form-control" id="groupImage" name="groupImage" accept="image/*">
                  </div>

                  <!-- Description -->
                  <div class="mb-3">
                    <label for="groupDescription" class="form-label small fw-semibold text-muted">Description</label>
                    <textarea class="form-control" id="groupDescription" name="groupDescription" rows="3" placeholder="What's this group about?" style="resize: none;"></textarea>
                  </div>

                </div>

                <!-- RIGHT SIDE: ADD MEMBERS (SCROLLABLE) -->
                <div class="col-12 col-md-6 ps-md-3">
                  <label class="form-label small fw-semibold text-muted mb-2">Add Members</label>
                  
                  <!-- Scrollable Container -->
                  <div class="member-select-list rounded border p-2" style="max-height: 250px; overflow-y: auto;">
                    <% if (users.length > 0) { %>
                      <% users.forEach(item => { %>
                        <div class="form-check d-flex align-items-center justify-content-between p-2 rounded hover-bg mb-1">
                          <div class="d-flex align-items-center overflow-hidden me-2">
                            <img src="<%= item.user.profilePicture %>" alt="<%= item.user.fullName %>" class="chat-avatar me-2" style="width: 32px; height: 32px;">
                            <span class="text-truncate small fw-medium text-dark">
                              <%= item.user.fullName %>
                            </span>
                          </div>
                          <input class="form-check-input mt-0" type="checkbox" name="members" value="<%= item.user._id %>" id="user_<%= item.user._id %>">
                        </div>
                      <% }) %>
                    <% } else { %>
                      <p class="text-muted small text-center my-3">No members found</p>
                    <% } %>
                  </div>
                </div>

              </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-top-0 pt-0">
              <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary btn-sm px-4">Create Group</button>
            </div>
          </form>

        </div>
      </div>
    </div>