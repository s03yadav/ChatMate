<!-- Bootstrap 5 JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Socket.IO Client -->
<script src="/socket.io/socket.io.js"></script>

<script>
  // =========================================================
  // 1. SOCKET CONNECTION & GLOBAL VARIABLES
  // =========================================================

  const socket = io();

  // Active chat state
  let currentChatId = null;
  let selectedChatItem = null;

  // Active team chat state
  let currentTeamId = null;
  let currentTeamChatId = null;
  let currentTeamMembers = [];

  // Utilities & context
  let lastMessageDate = null;
  const loggedUserId = "<%= loggedUser.id %>";


  // =========================================================
  // 2. DOM ELEMENT REFERENCES
  // =========================================================

  // Direct chat input elements
  const sendBtn = document.getElementById('sendBtn');
  const messageInput = document.getElementById('messageInput');

  // Direct chat header elements
  const profileImg = document.getElementById("chatProfilePicture");
  const userName = document.getElementById("chatUserName");
  const userStatus = document.getElementById("chatUserStatus");

  // Screen containers
  const emptyChat = document.getElementById("emptyChat");
  const activeChat = document.getElementById("activeChat");
  const messagesContainer = document.getElementById('messagesContainer');

  // Message template reference elements
  const dateDivider = document.querySelector('.date-divider');
  const incommingMsg = document.getElementById('incomming-msg');
  const outgoingMsg = document.getElementById('outgoing-msg');

  // Receiver profile / modal elements
  const receiverProfileImg = document.getElementById("receiverProfileImg");
  const receiverName = document.getElementById("receiverName");
  const receiverDesignation = document.getElementById("receiverDesignation");
  const receiverEmail = document.getElementById("receiverEmail");
  const reciverStatus = document.getElementById("reciverStatus");

  // Team chat elements
  const teamChat = document.getElementById("teamChat");
  const teamMessagesContainer = document.getElementById("teamMessagesContainer");
  const teamProfilePicture = document.getElementById("teamProfilePicture");
  const teamName = document.getElementById("teamName");
  const teamUserStatus = document.getElementById("teamUserStatus");
  const teamMessageInput = document.getElementById("teamMessageInput");
  const teamSendBtn = document.getElementById("teamSendBtn");


  // =========================================================
  // 3. SOCKET CONNECTION EVENTS
  // =========================================================

  socket.on("connect", () => {
    console.log("Connected:", socket.id);
  });

  socket.on("connect_error", (err) => {
    console.log(err.message);
  });


  // =========================================================
  // 4. CHAT SELECTION EVENT LISTENERS
  // =========================================================

  // Listen for clicks on individual direct chat items
  document.querySelectorAll(".user").forEach(user => {
    user.addEventListener('click', () => {
      selectedChatItem = user;
      const receiverId = user.dataset.id;

      socket.emit("open-chat", { receiverId });
    });
  });

  // Listen for clicks on team chat items
  document.querySelectorAll(".team-item").forEach(team => {
    team.addEventListener('click', () => {
      const teamId = team.dataset.id;
      currentTeamId = teamId;
      console.log(`Team ID : ${teamId}`);

      socket.emit('open-teamChat', { teamId });
    });
  });


  // =========================================================
  // 5. DIRECT CHAT EVENT HANDLERS & HELPERS
  // =========================================================

  // Triggered when a direct chat room is loaded
  socket.on("chat-opened", (data) => {
    console.log(data);

    currentChatId = data.chatId;

    // Reset active team chat context
    currentTeamChatId = null;
    currentTeamId = null;

    if (selectedChatItem) {
      selectedChatItem.dataset.chatId = data.chatId;
    }

    const openedChatItem = document.querySelector(`.user[data-chat-id="${data.chatId}"]`);
    if (openedChatItem) {
      openedChatItem.classList.remove("unread");
    }

    // Header info
    profileImg.src = data.receiver.profilePicture;
    userName.innerText = data.receiver.fullName;
    userStatus.innerText = data.receiver.status;

    // Status styling
    userStatus.classList.remove("text-muted", "text-success", "text-danger");
    if (userStatus.innerText === "Online") {
      userStatus.classList.add("text-success");
    } else {
      userStatus.classList.add("text-danger");
    }

    // Receiver modal info
    receiverProfileImg.src = data.receiver.profilePicture;
    receiverName.innerHTML = data.receiver.fullName;
    receiverDesignation.innerHTML = data.receiver.desgination || "";
    receiverEmail.innerHTML = data.receiver.email || "";
    reciverStatus.innerHTML = data.receiver.status || "";

    // Toggle container views
    emptyChat.classList.add("d-none");
    emptyChat.classList.remove("d-flex");

    teamChat.classList.add("d-none");
    teamChat.classList.remove("d-flex");

    activeChat.classList.remove("d-none");
    activeChat.classList.add("d-flex");

    // Clear and render messages
    messagesContainer.innerHTML = "";
    data.messages.forEach(message => {
      appendMessage(message);
    });
  });

  // Send direct message
  sendBtn.addEventListener('click', () => {
    const text = messageInput.value.trim();

    if (!text || !currentChatId) return;

    socket.emit("send-message", {
      chatId: currentChatId,
      text
    });

    messageInput.value = "";
  });

  // Receive direct message
  socket.on("receive-message", (message) => {
    console.log("Receive Message : ", message);

    updateChatPreview(message);

    if (String(message.chatId) === String(currentChatId)) {
      appendMessage(message);
    }
  });

  // Append single message to direct chat DOM
  function appendMessage(message) {
    console.log(message);

    const messagesContainer = document.getElementById("messagesContainer");
    const isMine = String(message.sender.id || message.sender._id) === String(loggedUserId);

    const messageDate = new Date(message.createdAt);
    const currentDate = messageDate.toDateString();

    if (currentDate !== lastMessageDate) {
      const dateDivider = document.createElement("div");
      dateDivider.classList.add("date-divider");
      dateDivider.innerText = messageDate.toLocaleDateString("default", {
        day: "numeric",
        month: "long",
        year: "numeric"
      });

      messagesContainer.appendChild(dateDivider);
      lastMessageDate = currentDate;
    }

    const messageRow = document.createElement("div");
    messageRow.classList.add("message-row");
    messageRow.classList.add(isMine ? "outgoing" : "incoming");

    const bubble = document.createElement("div");
    bubble.classList.add("message-bubble");

    const text = document.createElement("div");
    text.classList.add("message-text");
    text.innerText = message.text;

    const time = document.createElement("div");
    time.classList.add("message-time");
    time.innerText = new Date(message.createdAt).toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit"
    });

    bubble.appendChild(text);
    bubble.appendChild(time);
    messageRow.appendChild(bubble);
    messagesContainer.appendChild(messageRow);

    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  // Update direct chat sidebar preview
  function updateChatPreview(message) {
    const chatItem = document.querySelector(`.user[data-chat-id="${message.chatId}"]`);
    if (!chatItem) return;

    const preview = chatItem.querySelector(".chat-preview");
    if (preview) {
      preview.innerText = message.text.slice(0, 15);
    }

    const time = chatItem.querySelector('.chat-time');
    if (time) {
      time.innerText = new Date(message.createdAt).toLocaleTimeString("default", {
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    const isReceivedMsg = String(loggedUserId) !== String(message.sender.id);
    if (isReceivedMsg && message.seen === false) {
      chatItem.classList.add('unread');
    }
  }


  // =========================================================
  // 6. TEAM CHAT EVENT HANDLERS & HELPERS
  // =========================================================

  // Triggered when a team chat room is loaded
  socket.on("team-chat-opened", (data) => {
    console.log("Team Chat Opened :", data);

    currentTeamId = data.team._id;
    currentTeamChatId = data.chat._id;

    // Reset active direct chat context
    currentChatId = null;
    selectedChatItem = null;

    const teamItem = document.querySelector(`.team-item[data-chat-id="${data.chat._id}"]`);
    if (teamItem) {
      teamItem.classList.remove("unread");
    }

    currentTeamMembers = data.members;

    // Header info
    teamProfilePicture.src = data.team.groupPicture || "/user/default.jpg";
    teamName.innerText = data.team.name;

    const onlineMembers = data.members.filter(member => member.status === "Online");
    teamUserStatus.innerText = `${onlineMembers.length} Members Online`;

    // Toggle container views
    emptyChat.classList.add("d-none");
    emptyChat.classList.remove("d-flex");

    activeChat.classList.add("d-none");
    activeChat.classList.remove("d-flex");

    teamChat.classList.remove("d-none");
    teamChat.classList.add("d-flex");

    // Clear and render messages
    teamMessagesContainer.innerHTML = "";
    data.messages.forEach(message => {
      appendTeamMessage(message);
    });
  });

  // Send team message
  teamSendBtn.addEventListener("click", () => {
    const text = teamMessageInput.value.trim();

    if (!text || !currentTeamChatId) return;

    socket.emit("send-team-message", {
      chatId: currentTeamChatId,
      text: text
    });

    teamMessageInput.value = "";
  });

  // Receive team message
  socket.on("receive-team-message", (message) => {
    updateTeamPreview(message);

    if (String(message.chatId) === String(currentTeamChatId)) {
      appendTeamMessage(message);
    }
  });

  // Append single message to team chat DOM
  function appendTeamMessage(message) {
    const isMine = String(message.sender._id || message.sender.id) === String(loggedUserId);
    const messageRow = document.createElement("div");

    const messageDate = new Date(message.createdAt);
    const currentDate = messageDate.toLocaleDateString();

    if (currentDate !== lastMessageDate) {
      const dateDivider = document.createElement("div");
      dateDivider.classList.add("date-divider");
      dateDivider.innerText = messageDate.toLocaleDateString("default", {
        day: "numeric",
        month: "long",
        year: "numeric"
      });

      teamMessagesContainer.appendChild(dateDivider);
      lastMessageDate = currentDate;
    }

    messageRow.classList.add("message-row", "d-flex", "align-items-end", "gap-2");
    messageRow.classList.add(isMine ? "outgoing" : "incoming");
    if (isMine) messageRow.classList.add("flex-row-reverse");
    else messageRow.classList.add("flex-row");

    // Avatar
    const profile = document.createElement("img");
    profile.classList.add("message-avatar", "mb-1");
    profile.src = message.sender.profilePicture || "/user/default.jpg";
    profile.alt = message.sender.fullName;

    // Message Container
    const content = document.createElement("div");
    content.classList.add("message-content");

    // Sender Label
    if (!isMine) {
      const senderName = document.createElement("span");
      senderName.classList.add("sender-name");
      senderName.innerText = message.sender.fullName;
      content.appendChild(senderName);
    }

    // Bubble
    const bubble = document.createElement("div");
    bubble.classList.add("message-bubble");
    bubble.innerText = message.text;

    // Timestamp
    const time = document.createElement("div");
    time.classList.add("message-time");
    time.innerText = new Date(message.createdAt).toLocaleTimeString([], {
      hour: "2-digit",
      minute: "2-digit"
    });

    content.appendChild(bubble);
    content.appendChild(time);
    messageRow.appendChild(profile);
    messageRow.appendChild(content);

    teamMessagesContainer.appendChild(messageRow);
    teamMessagesContainer.scrollTop = teamMessagesContainer.scrollHeight;
  }

  // Update team chat sidebar preview
  function updateTeamPreview(message) {
    const teamItem = document.querySelector(`.team-item[data-chat-id="${message.chatId}"]`);
    if (!teamItem) return;

    const preview = teamItem.querySelector(".chat-preview");
    if (preview) {
      preview.innerText = message.text.slice(0, 15);
    }

    const time = teamItem.querySelector(".chat-time");
    if (time) {
      time.innerText = new Date(message.createdAt).toLocaleTimeString("default", {
        hour: "2-digit",
        minute: "2-digit"
      });
    }

    const isReceivedMessage = String(message.sender.id) !== String(loggedUserId);
    const isTeamChatClosed = String(message.chatId) !== String(currentTeamChatId);

    if (isReceivedMessage && isTeamChatClosed) {
      teamItem.classList.add("unread");
    }
  }
</script>